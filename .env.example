# Spring Boot does not load this file automatically.
# Load it with: set -a; source .env; set +a
SPRING_PROFILES_ACTIVE=local

# Local MySQL
DB_URL="jdbc:mysql://localhost:3306/hamsafar?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Dushanbe"
DB_USERNAME=root
DB_PASSWORD=

# JPA creates and updates the local development schema.
DDL_AUTO=update

DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_KEEPALIVE_TIME_MS=300000

SERVER_ADDRESS=127.0.0.1
PORT=8080
