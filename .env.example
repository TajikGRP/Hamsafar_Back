# Spring Boot does not load this file automatically.
# Load it with: set -a; source .env; set +a
SPRING_PROFILES_ACTIVE=prod

# Recommended for Render: Supavisor session pooler (port 5432).
DB_URL="jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require&ApplicationName=hamsafar"
DB_USERNAME="postgres.YOUR_PROJECT_REF"
DB_PASSWORD="replace-with-your-database-password"
DB_SCHEMA=app

FLYWAY_ENABLED=true
DDL_AUTO=validate

# Keep this conservative on Supabase Free/Pro and Render Free.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_KEEPALIVE_TIME_MS=300000

# Local only. Render injects PORT automatically.
PORT=8080
